{
  "name": "@argus/mcp",
  "version": "0.1.0",
  "description": "Argus MCP server — cloud browser verification tools for any MCP client.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/everyai-com/argus",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/everyai-com/argus",
  "keywords": ["mcp", "model-context-protocol", "testing", "verification", "browser", "cloudflare"],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "argus-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\" && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@argus/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.0"
  }
}
