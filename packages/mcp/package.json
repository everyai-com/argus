{
  "name": "@argus/mcp",
  "version": "0.1.0",
  "description": "Argus MCP server — cloud browser verification tools for any MCP client.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/everyai-com/argus",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/everyai-com/argus",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "verification",
    "browser",
    "cloudflare"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "argus-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\" && chmod +x dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@argus/shared": "workspace:*",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
